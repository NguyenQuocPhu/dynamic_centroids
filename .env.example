# Copy to .env and fill in real values (never commit .env -- already gitignored).
#
# When ALL THREE are set, rainbowplus.py routes target_llm, mutator_llm AND
# fitness_llm through this one OpenAI-compatible API instead of loading local
# models (see apply_api_override() in rainbowplus/rainbowplus.py).
# Leave all three unset/empty to keep the original local-model behavior.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=

# ── Paper setup (paper/SERVER_HANDOFF.md) ─────────────────────────────────────
# OPENAI_* above = attacker (mutator) + in-loop judge: the Qwen3.5-35B proxy.
# Target models are served by Modal (paper/modal/serve_targets.py):
MODAL_TARGET_API_KEY=          # same value as the Modal secret paper-vllm-key / VLLM_API_KEY
MODAL_WORKSPACE=               # your Modal workspace name -> endpoint urls are derived from it
# ...or give each url explicitly (wins over MODAL_WORKSPACE):
# TARGET_URL_LLAMA31_8B=https://<ws>--paper-targets-llama31-8b.modal.run/v1
# TARGET_URL_GEMMA2_9B=https://<ws>--paper-targets-gemma2-9b.modal.run/v1
# TARGET_URL_QWEN25_7B=https://<ws>--paper-targets-qwen25-7b.modal.run/v1
# TARGET_URL_MINISTRAL_8B=https://<ws>--paper-targets-ministral-8b.modal.run/v1
# JUDGE_URL_HARMBENCH=https://<ws>--paper-judges-harmbench-cls.modal.run/v1
# JUDGE_URL_LLAMAGUARD=https://<ws>--paper-judges-llamaguard3.modal.run/v1
OPENCODE_API_KEY=              # OpenCode Go key: post-hoc LLM judges (paper/eval/judges.yaml)
# PAPER_RUNS=runs/paper        # where runs are written (NEVER under /tmp)
# BACKUP_CMD='rclone copy {file} remote:paper'   # optional off-box copy of each backup
