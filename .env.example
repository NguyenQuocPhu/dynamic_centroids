# Copy to .env and fill in real values (never commit .env -- already gitignored).
#
# When ALL THREE are set, rainbowplus.py routes attack_model, target_model AND
# eval_model through this one OpenAI-compatible API instead of loading 3 local
# vLLM models (see apply_api_override() in rainbowplus/rainbowplus.py).
# Leave all three unset/empty to keep the original local-vLLM behavior.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=
